# ─── signals-dpg local-setup — environment (Track A / Docker-only) ──────────
# Copy to .env in THIS directory (signals-dpg/local-setup/) and adjust if needed.
# `docker compose` here reads this file. Working dev defaults are pre-filled —
# regenerate the secrets before using on any shared host.
#
# (Track B / hybrid runs from the repo root using signals-dpg's own root
# .env.example — see LOCAL_SETUP.md §6.)

# ── Instance / network
INSTANCE_NAME=signals-local
# Which network config under examples/schemas/<network>/network.json to load,
# and the domains this instance serves.
SIGNALS_NETWORK=blue_dot
SERVED_DOMAINS=blue_dot/seeker,blue_dot/provider

# ── Secrets (CHANGE for any shared host) ────────────────────────────────────
# Auth signing secret.
AUTH_SECRET=dev-auth-secret-change-me
# PII encryption key — MUST be base64 that decodes to exactly 32 bytes.
# Generate a fresh one with: openssl rand -base64 32
SIGNALS_PII_KEY=s514vYM9fPuAE020m0v4CfevArrF2+Nzi6st/FzawA8=

# ── API / UI ports (host)
API_PORT=2742
# Optional API base URL used as this instance identity in item/action URLs.
# For reverse-proxy subpath deployments, set full base (e.g. http://host/purple-dot-api).
API_DOMAIN=http://localhost
# Signals UI is fixed to host :5173 (API CORS allow-list is 3000/5173/2742).

# Optional UI compile-time API fallback.
# Runtime /config.js can still override this in deployed environments.
VITE_API_URL=http://localhost:2742

# Optional UI subpath base (e.g. /purpledot/ for reverse-proxy path hosting).
# Keep as / for local root hosting.
VITE_BASE_PATH=/

# Comma-separated CORS/trusted origins for API + auth (no path segments).
# Add your host origin(s) when exposing the stack publicly.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:2742

# ── Postgres (host port + creds; the compose builds a pgvector+postgis image)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=dev-postgres-password-change-me
POSTGRES_DB=postgresdb
DATABASE_PORT=5432

# ── Redis (password-protected; host port 5555 → container 6379)
REDIS_PASSWORD=dev-redis-password-change-me
REDIS_PORT=5555

# ── Metabase embed (for UI Dashboard iframe signed URL)
METABASE_SITE_URL=http://localhost:3030
METABASE_SECRET_KEY=change_me_metabase_secret
METABASE_DASHBOARD_ID=2

# ── Match score / dpg-scoring (optional; used by /api/v1/match-score)
# Use the same values as root .env when root match-score container is running.
MATCH_SCORE_PROVIDER=dpg_scoring
DPG_SCORING_ENDPOINT=http://dpg-match-score:5103
DPG_SCORING_KEY_ID=enter_dpg_scoring_key_id
DPG_SCORING_SECRET=enter_dpg_scoring_secret
# Optional, defaults to api/v1/scores/match
# DPG_SCORING_PATH=api/v1/scores/match
